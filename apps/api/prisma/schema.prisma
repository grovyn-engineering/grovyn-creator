// SocialPilot — database schema
//
// The database is the source of truth. Nothing here derives from Zernflow's
// Supabase schema; this is a new model built around the V1 domain.
//
// Two rules shape almost every decision below:
//   1. Every tenant-owned row carries `workspaceId` directly, even when it
//      could be reached through a parent. A workflow execution could find its
//      workspace via its workflow, but denormalizing it means the tenant
//      filter is always a column on the table being queried — an authorization
//      check that cannot be lost in a join.
//   2. Idempotency is enforced by unique constraints, not by application
//      logic. A read-then-write check races; a constraint does not.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Enums — kept in lockstep with packages/contracts/src/enums.ts by
// apps/api/src/config/enum-parity.test.ts
// ─────────────────────────────────────────────────────────────────────────

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum SocialPlatform {
  INSTAGRAM
}

enum InstagramAccountStatus {
  ACTIVE
  EXPIRED
  REVOKED
  DISCONNECTED
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  PAUSED
}

enum WorkflowTriggerType {
  COMMENT_RECEIVED
  MESSAGE_RECEIVED
  MENTION_RECEIVED
}

enum ConditionOperator {
  equals
  not_equals
  contains
  not_contains
  starts_with
  ends_with
}

enum WorkflowActionType {
  REPLY_TO_COMMENT
  SEND_DIRECT_MESSAGE
  LIKE_COMMENT
}

enum ExecutionStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum ExecutionMode {
  LIVE
  DRY_RUN
}

enum WebhookEventType {
  COMMENT
  MESSAGE
  MENTION
  UNKNOWN
}

enum AuditAction {
  USER_SIGNED_UP
  USER_LOGGED_IN
  USER_LOGGED_OUT
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  INSTAGRAM_CONNECTED
  INSTAGRAM_DISCONNECTED
  WORKFLOW_CREATED
  WORKFLOW_UPDATED
  WORKFLOW_DELETED
  WORKFLOW_ENABLED
  WORKFLOW_DISABLED
  WORKFLOW_EXECUTED
  WORKFLOW_FAILED
}

enum AuditEntityType {
  USER
  WORKSPACE
  INSTAGRAM_ACCOUNT
  WORKFLOW
  WORKFLOW_EXECUTION
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id    String @id @default(cuid())
  email String @unique
  name  String

  /// Argon2id hash. There is no code path that reads this outside
  /// auth.service; every user-facing type omits it.
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions   Session[]
  /// Workspaces this user owns. Kept separate from `memberships` so
  /// "who owns this" survives a membership row being removed.
  ownedWorkspaces Workspace[]      @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  auditLogs       AuditLog[]

  @@map("users")
}

/// Server-side sessions rather than self-contained JWTs: logging out, and
/// revoking every session after a password change, both have to be immediate,
/// and a stateless token cannot be withdrawn before it expires.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the cookie value, never the value itself. A database leak
  /// then yields no usable session cookies.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Denormalized so the whole request context is one row read, and so a
  /// stale cookie naming a deleted workspace can be detected without a join.
  activeWorkspaceId String?

  expiresAt DateTime
  createdAt DateTime @default(now())
  /// Refreshed on use; drives idle-timeout cleanup.
  lastSeenAt DateTime @default(now())

  /// Diagnostics only. Never used as an authentication factor — both are
  /// client-controlled and routinely change mid-session on mobile networks.
  userAgent String?
  ipAddress String?

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Tenancy
// ─────────────────────────────────────────────────────────────────────────

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members           WorkspaceMember[]
  instagramAccounts InstagramAccount[]
  workflows         Workflow[]
  executions        WorkflowExecution[]
  webhookEvents     WebhookEvent[]
  auditLogs         AuditLog[]
  oauthStates       OAuthState[]

  @@index([ownerId])
  @@map("workspaces")
}

/// V1 only ever writes OWNER rows, but the table and every authorization
/// check are written against the full role ladder, so inviting a collaborator
/// later is a feature rather than a migration plus an authorization rewrite.
model WorkspaceMember {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  role WorkspaceRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The membership lookup on every authenticated request hits this exactly.
  @@unique([workspaceId, userId])
  /// "Which workspaces can this user see?" — the switcher's query.
  @@index([userId])
  @@map("workspace_members")
}

// ─────────────────────────────────────────────────────────────────────────
// Instagram
// ─────────────────────────────────────────────────────────────────────────

model InstagramAccount {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Instagram's own id for the account, stable across username changes.
  ///
  /// Globally unique, not unique per workspace. Meta delivers a webhook keyed
  /// only by this id, so if two workspaces connected the same account an
  /// inbound comment would have no single owner and would execute twice.
  /// Connecting an account already claimed elsewhere returns CONFLICT.
  instagramUserId String @unique

  username          String
  displayName       String?
  profilePictureUrl String?

  status InstagramAccountStatus @default(ACTIVE)

  /// AES-256-GCM ciphertext, `iv:tag:data` base64. Decrypted only inside
  /// instagram.token.service; never selected by any read that feeds a
  /// response, never logged, never in an error message.
  accessTokenEncrypted String

  /// Null when Meta issued a token without a stated expiry.
  tokenExpiresAt DateTime?
  /// When the token was last successfully refreshed, for the refresh job.
  tokenRefreshedAt DateTime?

  /// Meta's numeric page/business id, needed for some Graph endpoints.
  metaPageId String?

  connectedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  webhookEvents WebhookEvent[]

  /// Webhook routing: platform id → account → workspace, on every event.
  @@index([workspaceId])
  @@index([status])
  @@map("instagram_accounts")
}

/// Pending OAuth authorizations. The `state` parameter is stored server-side
/// and consumed on callback, so a callback carrying a state this table has
/// never issued — or has already consumed — is rejected. Holding it in a
/// signed cookie instead would survive neither replay nor a cross-device flow.
model OAuthState {
  id String @id @default(cuid())

  /// Random 32 bytes, base64url. The value echoed back by Meta.
  state String @unique

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Who started the flow. The callback runs in a fresh browser navigation,
  /// so this is how the completed connection is attributed.
  userId String

  platform SocialPlatform @default(INSTAGRAM)

  /// Where to send the browser once the flow finishes. Validated against an
  /// allowlist before use — an open redirect here would be handed a token.
  returnTo String?

  /// Set when the state is exchanged. A second callback with the same state
  /// is a replay and is refused.
  consumedAt DateTime?

  /// Short-lived; a sweep deletes expired rows.
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@index([workspaceId])
  @@map("oauth_states")
}

// ─────────────────────────────────────────────────────────────────────────
// Workflows
// ─────────────────────────────────────────────────────────────────────────

model Workflow {
  id String @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name        String
  description String?

  status      WorkflowStatus      @default(DRAFT)
  triggerType WorkflowTriggerType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conditions WorkflowCondition[]
  actions    WorkflowAction[]
  executions WorkflowExecution[]

  /// The engine's hot query, run on every inbound event: active workflows in
  /// this workspace for this trigger. Column order matters — workspaceId is
  /// the most selective and is always supplied.
  @@index([workspaceId, status, triggerType])
  /// The workflows list page, newest first.
  @@index([workspaceId, updatedAt])
  @@map("workflows")
}

model WorkflowCondition {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// A member of ConditionField in contracts. Stored as text rather than an
  /// enum so adding a readable field is a code change, not a migration — the
  /// write path validates it against the closed set, so the column can never
  /// hold a value the evaluator does not understand.
  field String

  operator ConditionOperator

  /// Compared case-insensitively after trimming.
  value String

  /// Display and evaluation order. Conditions are ANDed, so order does not
  /// change the result, but it does keep the builder stable across edits.
  position Int @default(0)

  createdAt DateTime @default(now())

  @@index([workflowId])
  @@map("workflow_conditions")
}

model WorkflowAction {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  actionType WorkflowActionType

  /// Shape depends on `actionType` and is parsed through the discriminated
  /// union in contracts on both write and read. The column is Json rather
  /// than a column-per-action-type so a new action adds a Zod variant and
  /// an executor, with no migration.
  configuration Json

  /// Actions run in this order, and unlike conditions the order is meaningful
  /// — "reply publicly, then DM" is not the same as the reverse.
  position Int @default(0)

  createdAt DateTime @default(now())

  results WorkflowExecutionAction[]

  @@index([workflowId])
  @@map("workflow_actions")
}

// ─────────────────────────────────────────────────────────────────────────
// Execution
// ─────────────────────────────────────────────────────────────────────────

model WorkflowExecution {
  id String @id @default(cuid())

  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  /// Denormalized: every execution query is workspace-scoped, and reaching
  /// the workspace through the workflow would put the tenant filter in a join.
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Null for a manual test run, which has no originating event.
  webhookEventId String?
  webhookEvent   WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  status ExecutionStatus @default(PENDING)
  mode   ExecutionMode   @default(LIVE)

  /// Why a matched workflow did not act — "conditions not met", "account
  /// disconnected". Populated only for SKIPPED, and shown verbatim in the UI.
  skipReason String?

  /// The normalized event the run evaluated. Retained so a past execution can
  /// be explained after the workflow has been edited.
  inputData Json?

  /// Engine-level summary; per-action detail lives in the child rows.
  outputData Json?

  /// User-safe message. Provider error bodies go to the log, not here.
  error String?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  actionResults WorkflowExecutionAction[]

  /// Idempotency, enforced rather than checked: one event can produce at most
  /// one execution per workflow. A webhook redelivery that slips past the
  /// event-level dedupe still cannot double-execute — the insert conflicts.
  /// Nullable webhookEventId means manual test runs are unconstrained, which
  /// is the intent.
  @@unique([workflowId, webhookEventId])
  /// Dashboard and activity feed: workspace-scoped, newest first.
  @@index([workspaceId, startedAt])
  /// Dashboard aggregates grouped by status over a window.
  @@index([workspaceId, status, startedAt])
  /// A single workflow's execution history.
  @@index([workflowId, startedAt])
  @@index([webhookEventId])
  @@map("workflow_executions")
}

/// One row per action attempted, so a partially successful execution reports
/// exactly which step failed instead of collapsing to a single status.
model WorkflowExecutionAction {
  id String @id @default(cuid())

  executionId String
  execution   WorkflowExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  /// SetNull rather than Cascade: deleting an action from a workflow must not
  /// erase the record that it once ran.
  actionId String?
  action   WorkflowAction? @relation(fields: [actionId], references: [id], onDelete: SetNull)

  /// Snapshotted, so history survives the action row being deleted.
  actionType WorkflowActionType

  status ExecutionStatus @default(PENDING)

  /// Provider-side id of whatever was created — a reply id, a message id.
  externalId String?

  error String?

  position    Int       @default(0)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([executionId])
  @@index([actionId])
  @@map("workflow_execution_actions")
}

// ─────────────────────────────────────────────────────────────────────────
// Inbound events
// ─────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id String @id @default(cuid())

  /// Deterministic id derived from the platform's own identifiers — for a
  /// comment, `ig:comment:<commentId>`. The unique constraint here is the
  /// product's idempotency guarantee: Meta redelivering a change produces the
  /// same string, the insert conflicts, and nothing runs a second time.
  eventId String @unique

  /// Nullable because an event can arrive for an account this installation
  /// does not know. It is still stored (unattributed) rather than dropped, so
  /// "we received it and could not route it" is distinguishable from "it
  /// never arrived".
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  instagramAccountId String?
  instagramAccount   InstagramAccount? @relation(fields: [instagramAccountId], references: [id], onDelete: SetNull)

  platform  SocialPlatform   @default(INSTAGRAM)
  eventType WebhookEventType

  /// Meta's raw body, exactly as received. Kept for diagnostics and replay;
  /// never returned by an API — responses carry the normalized form.
  payload Json

  /// The normalized shape the engine consumed. Stored alongside the raw body
  /// so a normalizer change can be evaluated against real historical input.
  normalized Json?

  processed   Boolean   @default(false)
  processedAt DateTime?

  /// Set when processing threw. The row stays `processed = false` so a retry
  /// can pick it up.
  error String?

  /// Guards against a poison event being retried forever.
  attempts Int @default(0)

  createdAt DateTime @default(now())

  executions WorkflowExecution[]

  /// The worker's claim query: unprocessed, oldest first.
  @@index([processed, createdAt])
  /// The activity page, workspace-scoped and newest first.
  @@index([workspaceId, createdAt])
  @@index([instagramAccountId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit
// ─────────────────────────────────────────────────────────────────────────

/// Append-only. Nothing in the application updates or deletes a row here.
model AuditLog {
  id String @id @default(cuid())

  /// Null for account-level events that precede any workspace, such as signup.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Null when the actor is the system — a workflow the engine ran on a
  /// webhook has no human behind it.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     AuditAction
  entityType AuditEntityType
  entityId   String?

  /// Contextual detail. Passed through a redactor on write; a token or a
  /// password reaching this column would be a reportable defect.
  metadata Json?

  ipAddress String?

  createdAt DateTime @default(now())

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
