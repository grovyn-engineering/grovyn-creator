# ─────────────────────────────────────────────────────────────
# SocialPilot — environment template
#
# Copy to `.env` and fill in. Never commit `.env`.
# The API validates every variable below at startup (see
# apps/api/src/config/env.ts) and refuses to boot in production
# if a required one is missing or malformed.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# ── URLs ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000
PORT=5000

# ── Database ────────────────────────────────────────────────
# Matches the service in docker-compose.dev.yml.
DATABASE_URL=postgresql://socialpilot:socialpilot@localhost:5432/socialpilot?schema=public

# ── Redis (background jobs) ─────────────────────────────────
# Optional in development: if unset, the API processes webhook
# events in-process instead of via BullMQ. Required in production.
REDIS_URL=redis://localhost:6379

# ── Session ─────────────────────────────────────────────────
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── Encryption at rest ──────────────────────────────────────
# AES-256-GCM key for Instagram access tokens. EXACTLY 32 bytes, base64.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this key invalidates every stored token; accounts must reconnect.
TOKEN_ENCRYPTION_KEY=

# ── Meta / Instagram ────────────────────────────────────────
# From https://developers.facebook.com/apps → your app → App settings.
# META_APP_SECRET is server-only and must never reach the browser.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/instagram/callback
META_GRAPH_VERSION=v23.0

# A string you choose. Paste the same value into the Meta App Dashboard
# under Webhooks → Verify Token.
META_WEBHOOK_VERIFY_TOKEN=

# ── Development provider ────────────────────────────────────
# When true, Instagram OAuth and API calls are served by an in-memory mock
# so the full product can be exercised without Meta credentials.
# Forced to false when NODE_ENV=production — the API refuses to boot otherwise.
USE_MOCK_INSTAGRAM=true

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Frontend (apps/web) — only NEXT_PUBLIC_* reaches the browser.
# Nothing secret belongs here.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
