# ─────────────────────────────────────────────────────────────
# Frontend PRODUCTION Environment Template
#
# Copy to `frontend/.env.production` or `frontend/.env.production.local` on your AWS server.
#
# NEXT_PUBLIC_* variables are inlined into the client JavaScript bundle at BUILD time.
# Changing this variable requires rebuilding the frontend.
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_API_URL=https://api.yourdomain.com
