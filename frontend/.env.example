# ─────────────────────────────────────────────────────────────
# Frontend environment
#
# Copy to frontend/.env.local and adjust if your backend is elsewhere.
#
# EVERY variable here is public. `NEXT_PUBLIC_*` values are inlined into the
# JavaScript bundle at build time and are readable by anyone who opens the
# page — they are not configuration, they are published content.
#
# Never put any of these here:
#   DATABASE_URL, DIRECT_URL, SESSION_SECRET, TOKEN_ENCRYPTION_KEY,
#   META_APP_SECRET, JWT_SECRET, or any access token.
#
# The frontend does not need them. It talks to the backend over REST and the
# backend holds everything sensitive.
# ─────────────────────────────────────────────────────────────

# Where the backend lives. Inlined at BUILD time, not read at runtime — so
# changing it requires a rebuild, not a restart, and a different environment
# needs a different build.
NEXT_PUBLIC_API_URL=http://localhost:5000
