# ─────────────────────────────────────────────────────────────
# Backend environment
#
# Copy to backend/.env and fill in. Never commit .env.
#
# Everything here is server-only. None of it is ever sent to the browser —
# there is no build step that inlines these, and no NEXT_PUBLIC_ variable
# carries any of them.
#
# The server validates all of this at startup (src/config/env.ts) and refuses
# to boot with a readable report rather than failing later on a request.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# The exact origin allowed by CORS. Not a wildcard — a reflected origin with
# credentials would let any site drive this API with a user's session cookie.
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Database — Supabase PostgreSQL ──────────────────────────
#
# Supabase → your project → Connect → ORMs → Prisma.
# Supabase offers two connection strings and Prisma needs BOTH, for different
# reasons. Using one for both is the most common way this setup fails:
#
#   DATABASE_URL  → the POOLED connection (port 6543, "Transaction pooler").
#                   Used at runtime. The pooler is what lets a serverless or
#                   multi-instance deployment avoid exhausting Postgres
#                   connections. It cannot run migrations, because PgBouncer in
#                   transaction mode does not support prepared statements or
#                   advisory locks.
#
#   DIRECT_URL    → the DIRECT connection (port 5432). Used only by
#                   `prisma migrate` and `prisma db push`, which need a real
#                   session. Prisma reads it via `directUrl` in schema.prisma.
#
# Append ?pgbouncer=true&connection_limit=1 to DATABASE_URL — without
# pgbouncer=true, Prisma emits prepared statements the pooler rejects with
# "prepared statement s0 already exists".
#
# Replace [PASSWORD] with your database password (Project Settings → Database)
# and [PROJECT-REF] with your project reference.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── Redis (optional) ────────────────────────────────────────
# Leave empty and webhook events are processed in-process instead of through
# BullMQ. That is fine for development. Production requires it — in-process
# work does not survive a restart.
#
# No Docker needed: use a hosted Redis (Upstash has a free tier) or a local
# install. Paste the connection URL here.
REDIS_URL=

# ── Session ─────────────────────────────────────────────────
# 32+ random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── Encryption at rest ──────────────────────────────────────
# AES-256-GCM key for Instagram access tokens. EXACTLY 32 bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this invalidates every stored token; all accounts must reconnect.
# Back it up separately from the database — together they are the plaintext.
TOKEN_ENCRYPTION_KEY=

# ── Meta / Instagram ────────────────────────────────────────
# These are the *Instagram* App ID and Secret (App Dashboard → Instagram →
# API setup with Instagram login), NOT the Facebook App ID/Secret shown on the
# main settings page. Using the latter fails at token exchange.
#
# META_APP_SECRET is server-only and must never reach the browser.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:5000/api/instagram/callback
META_GRAPH_VERSION=v23.0

# A string you choose. Paste the same value into the Meta App Dashboard under
# Webhooks → Verify Token.
META_WEBHOOK_VERIFY_TOKEN=

# ── Development provider ────────────────────────────────────
# When true, Instagram OAuth and API calls are served by an in-memory mock, so
# the whole product works without Meta credentials or a public HTTPS callback.
# Forced false when NODE_ENV=production — the server refuses to boot otherwise.
USE_MOCK_INSTAGRAM=true

# ── Logging ─────────────────────────────────────────────────
LOG_LEVEL=info

# Trusted proxy hop count, for correct client IPs behind a load balancer.
# Set explicitly, never `true`, which trusts any X-Forwarded-For a client sends.
TRUST_PROXY=0
